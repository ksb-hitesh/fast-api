# Copy to .env and fill in. .env is gitignored - never commit it.
#
#   cp .env.example .env
#   uvicorn app:app --env-file .env --reload
#
# On Render you do NOT use this file. Set these in the dashboard instead
# (render.yaml already declares them) - see the README.

# ── required ──────────────────────────────────────────────────────────────────
# How you log in. The app refuses to start without it, so there is no way to
# accidentally deploy an open instance holding your evidence.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_PASSWORD=change-me-generate-a-real-one

# ── strongly recommended ──────────────────────────────────────────────────────
# Signs the session cookie. Render generates this for you. Set it locally too,
# otherwise a restart generates a new one and logs you out.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-generate-a-real-one

# MongoDB Atlas M0 - free, 512MB, no expiry. Without this the instance is
# EPHEMERAL: Render wipes out/ on every deploy, restart and idle spin-down,
# taking your RFC-3161 timestamped evidence with it. The app shows "ephemeral"
# in the header when this is unset.
#
# Atlas -> Network Access must allow 0.0.0.0/0, because Render has no static
# outbound IP. Security then rests entirely on this string: use a dedicated
# database user with a long generated password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=takedown

# ── optional ──────────────────────────────────────────────────────────────────
# Local only. Render sets PORT itself; the Dockerfile falls back to 8000.
PORT=8000
